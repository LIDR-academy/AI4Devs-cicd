{
    "name": "Prometheus-Kagent-Flow-v4",
    "active": true,
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "prometheus-alert",
                "responseMode": "responseNode",
                "options": {}
            },
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                0,
                0
            ],
            "id": "webhook-trigger",
            "name": "Prometheus Webhook",
            "webhookId": "prometheus-alert"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://kagent-controller.kagent.svc.cluster.local:8083/api/a2a/kagent/k8s-agent/",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { \"jsonrpc\": \"2.0\", \"method\": \"message/send\", \"params\": { \"message\": { \"role\": \"user\", \"parts\": [ { \"kind\": \"text\", \"text\": \"Analyze this Prometheus alert and provide triage steps: \" + JSON.stringify($json) } ] } }, \"id\": 1 } }}",
                "options": {
                    "timeout": 120000
                }
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                300,
                0
            ],
            "id": "invoke-kagent",
            "name": "Invoke Kagent Triage"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://hooks.slack.com/triggers/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",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { \"text\": '🚨 Alert: ' + ($node['Prometheus Webhook']?.json?.alerts?.[0]?.labels?.alertname || 'Unknown') + '\\n📋 Kagent Triage: ' + ($json?.result?.history ? $json.result.history.filter(h => h.role === 'agent').map(h => h.parts.map(p => p.text).join('')).join('') : 'No response from Kagent') } }}",
                "options": {
                    "timeout": 10000,
                    "alwaysOutputData": true
                }
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                600,
                0
            ],
            "id": "notify-slack",
            "name": "Send to Slack"
        },
        {
            "parameters": {
                "respondWith": "text",
                "responseBody": "OK"
            },
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                900,
                0
            ],
            "id": "respond",
            "name": "Respond OK"
        }
    ],
    "connections": {
        "Prometheus Webhook": {
            "main": [
                [
                    {
                        "node": "Invoke Kagent Triage",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Invoke Kagent Triage": {
            "main": [
                [
                    {
                        "node": "Send to Slack",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send to Slack": {
            "main": [
                [
                    {
                        "node": "Respond OK",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}