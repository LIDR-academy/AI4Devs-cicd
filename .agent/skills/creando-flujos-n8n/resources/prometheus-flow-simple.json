{
    "name": "Prometheus Alert Handler Simple",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "prometheus-alert",
                "responseMode": "responseNode",
                "options": {}
            },
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                0,
                0
            ],
            "id": "webhook-trigger",
            "name": "Prometheus Webhook",
            "webhookId": "prometheus-alert"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://hooks.slack.com/triggers/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",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\"text\": \"🚨 Prometheus Alert: \" + ($json.alerts ? $json.alerts[0].labels.alertname : \"Unknown\") + \" - Status: \" + ($json.status || \"unknown\")}",
                "options": {
                    "timeout": 10000
                }
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                250,
                0
            ],
            "id": "notify-slack",
            "name": "Send to Slack"
        },
        {
            "parameters": {
                "respondWith": "text",
                "responseBody": "OK"
            },
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                500,
                0
            ],
            "id": "respond",
            "name": "Respond OK"
        }
    ],
    "connections": {
        "Prometheus Webhook": {
            "main": [
                [
                    {
                        "node": "Send to Slack",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send to Slack": {
            "main": [
                [
                    {
                        "node": "Respond OK",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}