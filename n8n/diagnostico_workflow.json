{
  "name": "1. Alerta a SRE Agent vía n8n",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "prometheus-alert",
        "options": {}
      },
      "id": "1",
      "name": "Alerta Prometheus",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://kagent-controller:8083/api/a2a/default/sre-agent/",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"message/send\",\n  \"id\": \"1\",\n  \"params\": {\n    \"message\": {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"kind\": \"text\",\n          \"text\": \"Se ha recibido la alerta '{{ $json.body.alerts[0].labels.alertname || 'Alerta Genérica' }}' en el clúster. Investiga el estado, lee los logs de los pods de backend en default, aplica la remediación correspondiente y reporta tu acción final.\"\n        }\n      ]\n    }\n  }\n}",
        "options": {}
      },
      "id": "2",
      "name": "Disparar Agente SRE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [350, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/triggers/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",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: \"🤖 *Kagent SRE Agent Automation:*\\n\\n\" + $json.result.artifacts[0].parts[0].text }) }}",
        "options": {}
      },
      "id": "3",
      "name": "Notificar Slack Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [600, 300]
    }
  ],
  "connections": {
    "Alerta Prometheus": {
      "main": [
        [
          {
            "node": "Disparar Agente SRE",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Disparar Agente SRE": {
      "main": [
        [
          {
            "node": "Notificar Slack Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "id": "1"
}
