{
  "name": "2. Auto-Remediación con Kagent SRE Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-interactivity",
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Slack Interactive Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://kagent-controller:8083/api/a2a/default/sre-agent/",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"message/send\",\n  \"id\": \"1\",\n  \"params\": {\n    \"message\": {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"kind\": \"text\",\n          \"text\": \"Se ha confirmado la alerta. Por favor, investiga los pods de backend en el namespace default, ejecuta la mitigación necesaria usando tus herramientas (k8s_patch_resource o reiniciar) y reporta tu acción final.\"\n        }\n      ]\n    }\n  }\n}",
        "options": {}
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Disparar Agente SRE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [340, 300]
    },
    {
      "parameters": {
        "channel": "#alertas-sre",
        "text": "=✅ *Incidente Resuelto (Auto-Remediado)*\n\n*Acción ejecutada por SRE Agent:*\n{{ $json.result.artifacts[0].parts[0].text || \"El agente SRE ha ejecutado la remediación del servicio con éxito.\" }}",
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Actualizar Alerta en Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [580, 300]
    }
  ],
  "connections": {
    "Slack Interactive Webhook": {
      "main": [
        [
          {
            "node": "Disparar Agente SRE",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Disparar Agente SRE": {
      "main": [
        [
          {
            "node": "Actualizar Alerta en Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
